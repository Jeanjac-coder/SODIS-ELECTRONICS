# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.sodis-electronics.com

# ── Réception des demandes de devis par email ──────────────────────────────
# Destinataire des devis (plusieurs adresses possibles, séparées par des virgules)
QUOTE_TO_EMAIL=serviceclient@sodis-electronics.com
# Destinataire des autres formulaires (contact, rappel, rendez-vous, newsletter)
FORMS_TO_EMAIL=serviceclient@sodis-electronics.com

# Option 1 (recommandée) : SMTP de la boîte serviceclient@sodis-electronics.com
# Paramètres fournis par votre hébergeur email (cPanel, Zoho, Google Workspace, OVH…)
SMTP_HOST=mail.sodis-electronics.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=serviceclient@sodis-electronics.com
SMTP_PASS=
# Expéditeur affiché (par défaut : SMTP_USER)
FORMS_FROM_EMAIL="SODIS Electronics <serviceclient@sodis-electronics.com>"

# Option 2 : Resend (https://resend.com) — utilisé si SMTP_HOST est vide
RESEND_API_KEY=

# Accusé de réception envoyé au client après une demande de devis (true/false)
QUOTE_CONFIRMATION=true

# Optionnel : copie de chaque demande vers un webhook (Make, Zapier, n8n, CRM…)
FORMS_WEBHOOK_URL=
